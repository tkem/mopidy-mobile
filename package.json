{
    "name": "mopidy-mobile",
    "author": "Thomas Kemmer",
    "homepage": "https://github.com/tkem/mopidy-mobile/",
    "description": "Mopidy Web client for mobile devices",
    "license": "Apache-2.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/tkem/mopidy-mobile.git"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "lint": "ng lint",
        "test": "ng test --watch=false",
        "test:watch": "ng test",
        "test:coverage": "ng test --watch=false --code-coverage",
        "dist": "ng build && node scripts/dist.js",
        "clean": "rimraf --glob .angular build www \"mopidy_mobile/www/*.{js,css,txt}\" \"mopidy_mobile/www/{app,assets,css,lib,media}\""
    },
    "dependencies": {
        "@angular/common": "^20.3.0",
        "@angular/compiler": "^20.3.0",
        "@angular/core": "^20.3.0",
        "@angular/forms": "^20.3.0",
        "@angular/platform-browser": "^20.3.0",
        "@angular/router": "^20.3.0",
        "@ionic/angular": "^8.8.0",
        "@messageformat/core": "^3.4.0",
        "cordova-android": "^15.1.0",
        "cordova-plugin-add-swift-support": "^2.0.2",
        "cordova-plugin-appversion": "^1.0.0",
        "cordova-plugin-inappbrowser": "^7.0.0",
        "cordova-plugin-music-controls2": "^3.0.7",
        "cordova-plugin-x-socialsharing": "^6.0.4",
        "cordova-plugin-zeroconf": "^1.4.2",
        "es6-promise-plugin": "^4.2.2",
        "events": "^3.3.0",
        "ionicons": "^7.4.0",
        "mopidy": "^1.3.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.3.0",
        "@angular/cli": "^20.3.0",
        "@angular/compiler-cli": "^20.3.0",
        "@eslint/js": "^9.39.5",
        "@vitest/coverage-v8": "^3.2.7",
        "angular-eslint": "^20.7.0",
        "cordova": "^13.0.0",
        "eslint": "^9.39.0",
        "jsdom": "^26.1.0",
        "rimraf": "^6.1.4",
        "typescript": "~5.9.0",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.2.7"
    },
    "cordova": {
        "platforms": [
            "android"
        ],
        "plugins": {
            "cordova-plugin-appversion": {},
            "cordova-plugin-inappbrowser": {},
            "cordova-plugin-music-controls2": {},
            "cordova-plugin-x-socialsharing": {},
            "cordova-plugin-zeroconf": {}
        }
    }
}
